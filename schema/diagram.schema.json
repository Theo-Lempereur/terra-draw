{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Terra Draw — comparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "template", "title", "agent", "branches", "connectors"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "template": { "const": "comparison" },
    "title": { "$ref": "#/definitions/text" },
    "subtitle": { "$ref": "#/definitions/text" },
    "eyebrow": { "$ref": "#/definitions/text" },
    "agent": { "$ref": "#/definitions/card" },
    "branches": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title", "tone", "description", "cards", "tools"],
        "properties": {
          "title": { "$ref": "#/definitions/text" },
          "description": { "$ref": "#/definitions/text" },
          "tone": { "enum": ["amber", "green", "purple", "neutral"] },
          "cards": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/definitions/card" } },
          "tools": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/definitions/card" } }
        }
      }
    },
    "connectors": {
      "type": "array", "minItems": 1, "maxItems": 40,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["from", "to"],
        "properties": {
          "from": { "$ref": "#/definitions/id" }, "to": { "$ref": "#/definitions/id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 48 },
          "dashed": { "type": "boolean" },
          "tone": { "enum": ["amber", "green", "purple", "neutral"] }
        }
      }
    },
    "comparison": {
      "type": "array", "minItems": 1, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["label", "values"],
        "properties": {
          "label": { "$ref": "#/definitions/text" },
          "values": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/definitions/text" } }
        }
      }
    },
    "annotation": {
      "type": "object", "additionalProperties": false, "required": ["title", "body"],
      "properties": { "title": { "$ref": "#/definitions/text" }, "body": { "$ref": "#/definitions/text" } }
    },
    "footer": { "$ref": "#/definitions/text" }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 320 },
    "card": {
      "type": "object", "additionalProperties": false, "required": ["id", "title"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "$ref": "#/definitions/text" },
        "body": { "$ref": "#/definitions/text" },
        "icon": { "type": "string", "minLength": 1, "maxLength": 40 },
        "badge": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    }
  }
}
