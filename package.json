{
  "name": "terra-draw",
  "version": "0.1.0",
  "private": true,
  "description": "Schémas explicatifs locaux : JSON → HTML, PNG et PDF.",
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "terra-draw": "./bin/terra-draw.js" },
  "exports": "./src/render.js",
  "scripts": {
    "render": "node bin/terra-draw.js render",
    "example": "npm run render -- examples/mcp-vs-api.json --out dist/mcp-vs-api",
    "browser:install": "node scripts/install-browser.js",
    "dev": "node scripts/preview.js",
    "start": "node scripts/preview.js",
    "test": "node --test",
    "check": "node --check bin/terra-draw.js && node --check src/render.js && node --check src/template.js && node --check scripts/preview.js"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "ajv": "8.20.0",
    "playwright": "1.63.0"
  },
  "devDependencies": { "pdf-lib": "1.17.1" }
}
