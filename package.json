{
  "name": "terra-draw",
  "version": "0.2.0",
  "private": true,
  "description": "Schémas explicatifs locaux : un format pivot JSON/YAML, quatre modèles, export HTML, PNG et PDF.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "terra-draw": "./bin/terra-draw.js"
  },
  "exports": "./src/render.js",
  "scripts": {
    "render": "node bin/terra-draw.js render",
    "validate": "node bin/terra-draw.js validate",
    "templates": "node bin/terra-draw.js templates",
    "icons": "node bin/terra-draw.js icons",
    "example": "node scripts/examples.js",
    "browser:install": "node scripts/install-browser.js",
    "dev": "node scripts/preview.js",
    "start": "node scripts/preview.js",
    "test": "node --test",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "ajv": "8.20.0",
    "playwright": "1.63.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "pdf-lib": "1.17.1"
  }
}
